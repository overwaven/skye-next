TELEGRAM_BOT_TOKEN=
# All model requests use OpenRouter, including images, audio, and moderation.
OPENROUTER_API_KEY=
SKYE_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
SKYE_OWNER_IDS=
# Exa search (provider-independent web search/fetch, used instead of hosted tools).
# EXA key is read from SKYE_EXA_API_KEY.
# SKYE_EXA_API_KEY=
# Project API key from https://dashboard.composio.dev → Settings → API keys
# COMPOSIO_API_KEY=
# Flat rubles charged for one connector tool call, and the timeout for one MCP
# call through the local bridge.
# SKYE_CONNECTOR_CALL_RUB=0.50
# SKYE_CONNECTOR_TIMEOUT_SECONDS=30

# SKYE_DATABASE_PATH=data/skye.db
# SKYE_BASE_PROMPT_PATH=BASE_PROMPT.md
# SKYE_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash-1017
# /models chooses text and image models per user, even in a shared group chat.
# Hosts control the available entries, labels, and tiers using JSON arrays.
# Defaults contain all eight text and two image models in model_catalog.py.
# SKYE_TEXT_MODELS='[{"id":"deepseek/deepseek-v4.1-flash-1017","name":"DeepSeek V4.1 Flash 1017","tier":"Lightweight"}]'
# SKYE_IMAGE_MODELS='[{"id":"google/gemini-nano-banana-2.1","name":"Nano Banana 2.1","tier":"Medium"}]'
# SKYE_MODERATION_ENABLED=true
# Clairic extracts evidence; Clef makes probability-based safety decisions.
# SKYE_MODERATION_MODEL=cloudflare/clef
# SKYE_MODERATION_EXTRACTION_MODEL=cloudflare/clairic
# SKYE_MODERATION_THRESHOLD=0.5
# SKYE_DEFAULT_REASONING=medium
# SKYE_MAX_TURNS=20
# SKYE_RUN_TIMEOUT_SECONDS=300
# SKYE_COMPACTION_THRESHOLD_TOKENS=80000
# SKYE_MAX_CONTEXT_TOKENS=120000
# SKYE_MAX_OUTPUT_TOKENS=4000
# SKYE_TPM_BUDGET=1800000
# SKYE_MAX_CONCURRENT_RUNS=8
# SKYE_MAX_ATTACHMENT_BYTES=26214400
# SKYE_TRANSCRIPTION_MODEL=mistralai/voxtral-small-transcribe-3-0
# SKYE_SPEECH_MODEL=mistralai/voxtral-mini-tts-3-0
# SKYE_SPEECH_VOICE=gb_jane_neutral
# SKYE_IMAGE_MODEL=google/gemini-nano-banana-2.1
SKYE_IMAGE_PROVIDER=compatible
SKYE_AUDIO_PROVIDER=compatible
# Raw audio and non-PDF documents as native model inputs. Off by default:
# transcription plus local text extraction works with text+image models
# (for example DeepSeek V4) whose providers reject audio and file parts.
# SKYE_NATIVE_MEDIA=false
# Tool schemas are advertised as strict, which OpenAI enforces. Some
# OpenAI-compatible providers reject the flag (Beget answers 400 for
# tools[0].function.strict); set this to false there. The schemas themselves
# keep their strict shape either way.
# SKYE_TOOL_STRICT=true
# SKYE_GROUP_CONTEXT_MESSAGES=20
# SKYE_GROUP_CONTEXT_MESSAGE_CHARS=1500
# SKYE_GROUP_CONTEXT_TOTAL_CHARS=16000
# Pictures and files the user shares are kept per user or chat so any later
# message and any tool can reuse them, by name. Only the newest files are kept
# (fewer in groups), bounded by an idle TTL and byte caps.
# SKYE_FILES_DIR=data/files
# SKYE_FILES_TTL_SECONDS=2592000
# SKYE_FILES_SCOPE_BYTES=536870912
# SKYE_FILES_TOTAL_BYTES=5368709120
# SKYE_FILES_SCOPE_COUNT=50
# SKYE_FILES_GROUP_COUNT=20
# Own Docker sandbox for shell_exec/python/read_file/write_file. One container
# per command, but each user (private) and chat (group) keeps a persistent
# workspace on a shared volume; new and changed files are delivered
# automatically. Disabled by default.
# SKYE_SANDBOX_ENABLED=true
# SKYE_SANDBOX_IMAGE=python:3.14-slim
# SKYE_SANDBOX_TIMEOUT_SECONDS=120
# SKYE_SANDBOX_ALLOW_NETWORK=false
# Persistent workspaces: remove a scope after 7 idle days (0 disables), cap
# each scope at 1 GiB and all scopes at 20 GiB, run at most 4 commands at once.
# SKYE_SANDBOX_TTL_SECONDS=604800
# SKYE_SANDBOX_SCOPE_BYTES=1073741824
# SKYE_SANDBOX_TOTAL_BYTES=21474836480
# SKYE_SANDBOX_MAX_CONCURRENT=4
# Comma-separated domains reserved for future sandbox egress filtering.
# SKYE_SANDBOX_ALLOWED_DOMAINS=pypi.org,files.pythonhosted.org,github.com
# SKYE_TRACING=false
# Public origin used to build webhook automation URLs.
# SKYE_WEB_ORIGIN=https://sky.example.com
# Retail Sparks charged per 1 ruble of provider-reported cost. Sparks are the
# in-app currency users top up with Telegram Stars.
# SKYE_SPARKS_PER_RUB=1
# Host-set exchange rate for converting OpenRouter's USD usage.cost into rubles.
# Not an automatically refreshed FX quote.
# SKYE_USD_TO_RUB=100

# Logs are structured JSON on stdout and are viewed with Dozzle; see
# compose.yaml and AGENTS.md. There is nothing to configure here.
# Optional Fernet key for encrypted custom MCP credentials. Generate once with
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Back up the key and database together; losing/changing the key prevents decryption.
# SKYE_CONNECTOR_ENCRYPTION_KEY=
# Set true only after configuring Composio's project callback identity verifier and
# validating Telegram OAuth compatibility. See docs/web-stage6.md.
# SKYE_COMPOSIO_VERIFIER_ENABLED=false
