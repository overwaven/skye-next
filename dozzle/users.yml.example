# Copy to dozzle/users.yml and replace the password hash.
# Generate a hash with:
#   docker run -it --rm amir20/dozzle generate admin \
#     --password --email you@example.com --name "Admin"
users:
  admin:
    email: you@example.com
    name: Admin
    # bcrypt hash generated by the dozzle generate command above
    password: $2a$11$REPLACE_WITH_A_GENERATED_HASH_______________________
    filter:
    roles:
